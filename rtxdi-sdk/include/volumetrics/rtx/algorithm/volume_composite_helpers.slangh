#include "rtx/utility/common.slangh"
#include "rtx/utility/procedural_noise.slangh"
#include "rtx/utility/brdf.slangh"
#include "rtx/utility/froxel.slangh"
#include "rtx/utility/packing.slangh"
#include "rtx/concept/camera/camera.slangh"
#include "rtx/concept/light/spherical_harmonics.slangh"

#include "rtx/utility/procedural_noise.slangh"
#define VOLUME_LIGHTING_NO_NEE
#include "rtx/algorithm/volume_lighting.slangh"

float3 froxelIndexToTranslatedWorldPosition(uint3 voxelIndex, VolumeArgs volumeArgs, VolumeDefinitionCamera camera)
{
  const float3 froxelCoordinate = froxelIndexToFroxelCoordinate(voxelIndex);
  return froxelCoordinateToTranslatedWorldPosition(
    camera.projectionToTranslatedWorld, camera.viewToProjection, packedFlagGet(camera.flags, rightHandedFlag),
    volumeArgs.inverseFroxelGridDimensions, volumeArgs.froxelDepthSlices,
    volumeArgs.froxelDepthSliceDistributionExponent, volumeArgs.froxelMaxDistance, camera.nearPlane,
    froxelCoordinate);
}

// Returns the T value of a ray intersecting a portal, or a negative value if there is no valid intersection.
float getRayPortalIntersection(float3 origin, float3 direction, RayPortalHitInfo portal)
{
  const float NdotD = dot(direction, portal.normal);
  float t = dot(portal.centroid - origin, portal.normal) / NdotD;
  if (isinf(t) || isnan(t))
    return -1.0;
  
  if (t > 0 && NdotD < 0)
  {
    // Compute the UV coordinates of the ray-portal intersection
    vec3 p = origin + direction * t;
    vec3 cToP = p - portal.centroid.xyz;
    vec2 uv;
    uv.x = dot(cToP, portal.xAxis.xyz) * portal.inverseHalfWidth;
    uv.y = dot(cToP, portal.yAxis.xyz) * portal.inverseHalfHeight;

    // Consider only rays that fall inside the portal oval to be intersecting with the portal.
    // This minimizes interpolation artifacts when the preintegrated volumetric texture is sampled
    // near the edge of the portal, or rather, hides them under the burning portal edge mask.
    if (length(uv) < 0.95)
      return t;
  }

  return -1.0;
}

float3 evalFroxelCacheInScatter(
  Sampler3D<float4> volumeFilteredRadianceY, Sampler3D<float2> volumeFilteredRadianceCoCg,
  const VolumeArgs volumeArgs, float3 virtualFroxelUVW, uint froxelVolume, float3 viewDir)
{
  const float3 physicalFroxelUVW = virtualFroxelUVWToPhysicalFroxelUVW(
    virtualFroxelUVW, froxelVolume,
    volumeArgs.minFilteredRadianceU, volumeArgs.maxFilteredRadianceU, volumeArgs.inverseNumFroxelVolumes);

  const SphericalHarmonic sh = HarmonicsHelpers::loadFiltered3D<SphericalHarmonic>(
    volumeFilteredRadianceY, volumeFilteredRadianceCoCg, physicalFroxelUVW);

  // fogSunVisibilityGain scales only the anisotropic excess over isotropic SH.
  const float3 isotropicRadiance = sh.evaluateHenyeyGreenstein(viewDir, 0.0f);
  const float3 directionalRadiance = sh.evaluateHenyeyGreenstein(viewDir, volumeArgs.volumetricFogAnisotropy);
  return isotropicRadiance
    + (directionalRadiance - isotropicRadiance) * volumeArgs.fogSunVisibilityGain;
}

float3 evalUnoccludedReflectionInScatter(
  const VolumeArgs volumeArgs, float3 viewDir, float3 isotropicInScatter, float3 originWorld,
  float3 unoccludedSunRadiance, float3 unoccludedSunDirection)
{
  float3 lighting = isotropicInScatter;

  const float sunLen2 = dot(unoccludedSunDirection, unoccludedSunDirection);
  if (sunLen2 > 1e-8f)
  {
    const float3 sunDirN = unoccludedSunDirection * rsqrt(sunLen2);

    // Medium T only; same sample distance as distantLightSampleArea. No geometric vis.
    const float kDistantLightSampleDistance = 100000.0f;
    const float3 sunPosition = originWorld + sunDirN * kDistantLightSampleDistance;
    const float3 sunAtten = calcVolumetricAttenuation(
      volumeArgs, none, false, kDistantLightSampleDistance, sunPosition, -sunDirN);

    float3 sunY = unoccludedSunRadiance * sunAtten;
    const float fireflyThreshold = volumeArgs.froxelFireflyFilteringLuminanceThreshold
      * max(volumeArgs.fogSunFireflyScale, 1.0f);
    sunY = fireflyFiltering(sunY, fireflyThreshold);

    const float mu = dot(viewDir, sunDirN);
    const float g = volumeArgs.volumetricFogAnisotropy;
    // Linear SH HG (same as froxel evaluateHenyeyGreenstein), not analytic HG.
    const float3 sunIso = sunY * rcp(fourPi);
    const float3 sunDirEval = sunIso * (1.0f + 3.0f * g * mu);
    lighting += sunIso + (sunDirEval - sunIso) * volumeArgs.fogSunVisibilityGain;
  }

  return lighting;
}

// In-view reflection samples may read the froxel cache. View-Z past froxelMaxDistance is allowed
// (UVW.z saturates to the far slice). Reject behind the near plane, closer than the surface
// (would resample camera→surface), or outside clip XY.
bool reflectionCacheSampleValid(
  float3 translatedWorldPosition, VolumeDefinitionCamera camera, float startPositiveViewZ)
{
  const bool invertViewZ = packedFlagGet(camera.flags, rightHandedFlag);
  const float viewZSign = invertViewZ ? -1.0f : 1.0f;
  const float viewZ = mul(camera.translatedWorldToView, float4(translatedWorldPosition, 1.0f)).z;
  const float positiveViewZ = viewZ * viewZSign - camera.nearPlane;
  if (positiveViewZ <= 0.0f || positiveViewZ + 1e-3f < startPositiveViewZ)
  {
    return false;
  }

  const float4 clip = mul(camera.translatedWorldToProjectionJittered, float4(translatedWorldPosition, 1.0f));
  if (!(clip.w > 0.0f))
  {
    return false;
  }

  const float2 ndc = clip.xy / clip.w;
  return abs(ndc.x) <= 1.0f && abs(ndc.y) <= 1.0f;
}

// outMeanInScatter: step-length weighted mean of cache in-scatter, or zero if every step used
// uniformInScatter.
// isReflectionSegment: linear t from the surface; cache only when reflectionCacheSampleValid
// (do not clamp out-of-frustum UVW to an edge froxel).
void integrateVolumetricNEE(
  inout RNG randomState,
  Sampler3D<float> volumeFilteredRadianceAge, Sampler3D<float4> volumeFilteredRadianceY, Sampler3D<float2> volumeFilteredRadianceCoCg,
  const VolumeArgs volumeArgs, const float timeMS,
  const uint2 pixelCoordinate, float2 screenUV, bool primaryMiss,
  float3 startPosition, const float hitDistance, const float3 viewDir,
  inout float3 preintegratedRadiance, inout float3 accumulatedTransmittance,
  out float3 outMeanInScatter,
  bool useUniformInScatter = false, float3 uniformInScatter = vec3(0.0f, 0.0f, 0.0f),
  bool isReflectionSegment = false)
{
  outMeanInScatter = vec3(0.0f, 0.0f, 0.0f);

  // Check if the global volumetrics are enabled
  // Note: This ensures inscattering is not read and light is not attenuated by the global volumetric medium when
  // it's not desired.
  if (!volumeArgs.enable)
  {
    preintegratedRadiance = vec3(0.0f, 0.0f, 0.0f);
    accumulatedTransmittance = vec3(1.0f, 1.0f, 1.0f);
    return;
  }
  
  const uvec3 froxelDimensions = uvec3(volumeArgs.froxelGridDimensions, volumeArgs.froxelDepthSlices);
  
  uint2 froxelCoordinate = screenUV * volumeArgs.froxelGridDimensions;
  
  // Todo: This code is definately wrong as it is using the same camera across all the integration iterations despite the possibility
  // of passing into different Portal spaces (which require different volumetric cameras to translate positions into froxels properly).
  // This issue among others in this function are filed under REMIX-4162.
  const VolumeDefinitionCamera camera = volumeArgs.cameras[froxelVolumeMain];

  // Set up for a portal transition
  float portalIntersectionT = -1.0;
  uint froxelVolumeAfterPortal = 0;
  int currentFroxelVolume = froxelVolumeMain;

  // Evaluate parameters for a portal transition if there are multiple volumes
  if (volumeArgs.numActiveFroxelVolumes > 1)
  {
    // Construct a ray that represents the current column of froxels
    const float3 lastFroxelTranslatedWorldPosition = froxelIndexToTranslatedWorldPosition(
      uint3(froxelCoordinate, froxelDimensions.z - 1), volumeArgs, camera);
  
    const float3 rayOrigin = camera.translatedWorldOffset;
    const float3 rayDirection = normalize(lastFroxelTranslatedWorldPosition);
  
    // Find a portal that is intersected by the ray
    for (uint portalIndex = 0; portalIndex < cb.numActiveRayPortals; ++portalIndex)
    {
      portalIntersectionT = getRayPortalIntersection(rayOrigin, rayDirection, cb.rayPortalHitInfos[portalIndex]);
      if (portalIntersectionT > 0)
      {
        froxelVolumeAfterPortal = portalIndex + froxelVolumePortal0;
        break;
      }
    }
  }

  
  // Raymarch over the froxel grid
  
  // Apply some depth offset to minimize bleeding
  float volumetricMaxPathDistance =
    primaryMiss
      ? volumeArgs.froxelMaxDistance
      : hitDistance - (volumeArgs.froxelMaxDistance / volumeArgs.froxelDepthSlices) * volumeArgs.depthOffset;
  // Ensure we only integrate until the end of the volume
  // TODO: Could intersect ray with atmosphere plane for performance
  volumetricMaxPathDistance = clamp(volumetricMaxPathDistance, 0, volumeArgs.froxelMaxDistance);
  const float3 targetPosition = viewDir * volumetricMaxPathDistance + startPosition;
  
  // Setup some constants we'll use throughout integration
  const uint numSteps = froxelDimensions.z/4; // TODO: Expose this as a fraction of # depth slices - performance parameter?
  const float3 startPositionTranslated = worldToTranslatedWorld(camera, startPosition);
  const float3 targetPositionTranslated = worldToTranslatedWorld(camera, targetPosition);
  const float3 targetVector = targetPositionTranslated - startPositionTranslated;

  float3 previousTranslatedWorldPosition = startPositionTranslated;
  float3 lastInScatter = volumeArgs.multiScatteringEstimate;

  float startPositiveViewZ = 0.0f;
  if (isReflectionSegment)
  {
    const bool invertViewZ = packedFlagGet(camera.flags, rightHandedFlag);
    const float startViewZSign = invertViewZ ? -1.0f : 1.0f;
    startPositiveViewZ =
      mul(camera.translatedWorldToView, float4(startPositionTranslated, 1.0f)).z * startViewZSign
      - camera.nearPlane;
  }

  // Step length weighted so a nonlinear step distribution does not bias the mean toward the near steps.
  float3 meanInScatterSum = vec3(0.0f, 0.0f, 0.0f);
  float meanInScatterWeight = 0.0f;

  // Perform the integration
  for (uint z = 0; z < numSteps; z++)
  {
    // Step forward through the volume

    // Note: Apply blue noise dithering to sample through all the froxels within the current step's span temporally (as
    // currently the step count is a fraction of the number of froxels for performance reasons).
    // Additionally, z+1 and numSteps+1 used here to find the position of the first step away from the origin.
    const float t = (float(z + 1) + getNextSampleBlueNoise(randomState)) / float(numSteps + 1);
    // Camera rays use the froxel depth exponent. Reflection rays start at the surface, so t is linear.
    const float stepT = isReflectionSegment
      ? t
      : pow(t, volumeArgs.froxelDepthSliceDistributionExponent);
    const vec3 currentTranslatedWorldPosition = startPositionTranslated + targetVector * stepT;
    const float currentFroxelDistance = length(currentTranslatedWorldPosition);

    const float stepSize = length(currentTranslatedWorldPosition - previousTranslatedWorldPosition);

    const bool cacheSampleValid = !useUniformInScatter
      && (!isReflectionSegment
          || reflectionCacheSampleValid(currentTranslatedWorldPosition, camera, startPositiveViewZ));

    float3 virtualFroxelUVW = float3(0.0f, 0.0f, 0.0f);
    if (cacheSampleValid)
    {
      virtualFroxelUVW = translatedWorldPositionToFroxelUVW(
                                      camera.translatedWorldToView, camera.translatedWorldToProjectionJittered, packedFlagGet(camera.flags, rightHandedFlag),
                                      volumeArgs.froxelDepthSlices, volumeArgs.froxelDepthSliceDistributionExponent, volumeArgs.froxelMaxDistance, camera.nearPlane,
                                      currentTranslatedWorldPosition);

      // Use the age as a guide for filtering, Larger footprint for early samples

      const float3 centerPhysicalFroxelUVW = virtualFroxelUVWToPhysicalFroxelUVW(virtualFroxelUVW, currentFroxelVolume, volumeArgs.minFilteredRadianceU, volumeArgs.maxFilteredRadianceU, volumeArgs.inverseNumFroxelVolumes);
      const float age = volumeFilteredRadianceAge.SampleLevel(centerPhysicalFroxelUVW, 0);
      const float filterKernel = lerp(1.5f, 15.f, saturate(1.f - age));
      virtualFroxelUVW = calculateJitteredFroxelUvw(volumeArgs, virtualFroxelUVW, filterKernel);
    }
    
    // See if the ray has crossed a portal
    if (currentFroxelDistance > portalIntersectionT && portalIntersectionT > 0)
    {
      // Switch to the volume that represents this portal.
      // This is sufficient to get correct lighting sampled from that volume, as long as
      // the per-portal volumes have the same projection parameters as the main volume.
      // No froxel reprojection is necessary because the volume is constructed using this portal.
      currentFroxelVolume = froxelVolumeAfterPortal;
      // Prevent further switches
      portalIntersectionT = -1;
    }

    // Sample density field, for this we should use the actual world position (not translated)

    const float density = sampleDensityField(
      volumeArgs,
      camera,
      previousTranslatedWorldPosition,
      currentTranslatedWorldPosition,
      stepSize,
      timeMS
    ); 
    
    // Calculate new radiance for this marching step

    float3 accumulatedRadianceSample;

    if (cacheSampleValid)
    {
      accumulatedRadianceSample = evalFroxelCacheInScatter(
        volumeFilteredRadianceY, volumeFilteredRadianceCoCg,
        volumeArgs, virtualFroxelUVW, currentFroxelVolume, viewDir);

      meanInScatterSum += accumulatedRadianceSample * stepSize;
      meanInScatterWeight += stepSize;
    }
    else
    {
      accumulatedRadianceSample = uniformInScatter;
    }

    float3 lighting = accumulatedRadianceSample + volumeArgs.multiScatteringEstimate;
    float3 scatterCoeff = volumeArgs.scatteringCoefficient;

    // Low-sun: desaturate σ_s, mild warm bias, luminance-match (keeps cool media realistic).
    if (volumeArgs.fogSunsetColorBlend > 0.0f)
    {
      const float b = saturate(volumeArgs.fogSunsetColorBlend);
      const float sLum = max(calcBt709Luminance(volumeArgs.scatteringCoefficient), 1e-6f);
      scatterCoeff = lerp(volumeArgs.scatteringCoefficient, float3(sLum, sLum, sLum), saturate(b * 1.25f));

      float3 litScatter = lighting * scatterCoeff;
      const float3 warmMul = lerp(float3(1.0f, 1.0f, 1.0f), volumeArgs.fogSunsetWarmTint, b * 0.35f);
      const float3 warmed = litScatter * warmMul;
      const float lum0 = calcBt709Luminance(lighting * volumeArgs.scatteringCoefficient);
      const float lum1 = max(calcBt709Luminance(warmed), 1e-6f);
      litScatter = warmed * (lum0 / lum1);

      const float gCap = max(litScatter.x, litScatter.z) * 1.02f;
      litScatter.y = lerp(litScatter.y, min(litScatter.y, gCap), b);

      lighting = litScatter / max(sLum, 1e-6f);
      scatterCoeff = float3(sLum, sLum, sLum);
    }

    lastInScatter = lighting;
    const float3 outScattering = scatterCoeff * density;
  
    preintegratedRadiance += lighting * outScattering * accumulatedTransmittance * stepSize ;
    // Not via calcVolumetricAttenuation: density already carries the exp(-h/H) falloff, which that function
    // would apply a second time, leaving extinction quadratic in density while the in-scatter above is
    // linear in it.
    accumulatedTransmittance *= evalBeerLambertAttenuation(volumeArgs.attenuationCoefficient * density, stepSize);

    // Set the previous world position

    previousTranslatedWorldPosition = currentTranslatedWorldPosition;
  }

  if (meanInScatterWeight > 0.0f)
  {
    outMeanInScatter = meanInScatterSum / meanInScatterWeight;
  }
  
  // Beyond the froxel grid: Beer + homogeneous in-scatter from last froxel lighting.
  // lastInScatter already includes multiScatteringEstimate.
  if (primaryMiss || hitDistance > volumeArgs.froxelMaxDistance)
  {
    const bool infiniteTail = primaryMiss;
    const float remainDistance = infiniteTail
      ? 0.f
      : max(hitDistance - volumeArgs.froxelMaxDistance, 0.f);
    if (infiniteTail || remainDistance > 0.f)
    {
      const float3 remainT = calcVolumetricAttenuation(
        volumeArgs, camera, infiniteTail, remainDistance, previousTranslatedWorldPosition, viewDir);
      float3 singleScatterAlbedo = volumeArgs.scatteringCoefficient
        / max(volumeArgs.attenuationCoefficient, float3(1e-6f, 1e-6f, 1e-6f));
      if (volumeArgs.fogSunsetColorBlend > 0.0f)
      {
        const float b = saturate(volumeArgs.fogSunsetColorBlend);
        const float aLum = max(calcBt709Luminance(singleScatterAlbedo), 1e-6f);
        singleScatterAlbedo = lerp(singleScatterAlbedo, float3(aLum, aLum, aLum), saturate(b * 1.25f));
      }
      preintegratedRadiance += lastInScatter * singleScatterAlbedo
                             * (float3(1.0f, 1.0f, 1.0f) - remainT) * accumulatedTransmittance;
      accumulatedTransmittance *= remainT;
    }
  }
}
